    {
      "id": "ct-001",
      "name": "Employment Verification Form",
      "description": "Custom template for employment verification documents",
      "category": "verification",
      "createdBy": "user@example.com",
      "createdDate": "2024-01-10",
      "isActive": true,
      "pdfTemplate": "employment-verification-custom.pdf",
      "fields": {
        "employee": {
          "employeeName": {
            "pdfFieldName": "emp_name",
            "type": "text",
            "required": true,
            "label": "Employee Full Name",
            "coordinates": { "x": 150, "y": 120, "width": 200, "height": 20 },
            "validation": {
              "minLength": 2,
              "maxLength": 100
            }
          },
          "employeeId": {
            "pdfFieldName": "emp_id",
            "type": "text",
            "required": true,
            "label": "Employee ID",
            "coordinates": { "x": 400, "y": 120, "width": 100, "height": 20 },
            "validation": {
              "pattern": "^EMP\\d{4,6}$"
            }
          },
          "department": {
            "pdfFieldName": "emp_department",
            "type": "select",
            "required": true,
            "label": "Department",
            "options": [
              "Human Resources",
              "Finance",
              "Marketing",
              "Operations",
              "IT",
              "Sales",
              "Customer Service"
            ],
            "coordinates": { "x": 150, "y": 160, "width": 150, "height": 20 }
          },
          "position": {
            "pdfFieldName": "emp_position",
            "type": "text",
            "required": true,
            "label": "Job Title",
            "coordinates": { "x": 350, "y": 160, "width": 200, "height": 20 }
          },
          "startDate": {
            "pdfFieldName": "emp_start_date",
            "type": "date",
            "required": true,
            "label": "Employment Start Date",
            "coordinates": { "x": 150, "y": 200, "width": 120, "height": 20 }
          },
          "currentSalary": {
            "pdfFieldName": "emp_current_salary",
            "type": "currency",
            "required": false,
            "label": "Current Annual Salary",
            "coordinates": { "x": 300, "y": 200, "width": 120, "height": 20 }
          },
          "employmentStatus": {
            "pdfFieldName": "emp_status",
            "type": "select",
            "required": true,
            "label": "Employment Status",
            "options": [
              "Active Full-time",
              "Active Part-time",
              "Contract",
              "Terminated",
              "On Leave"
            ],
            "coordinates": { "x": 450, "y": 200, "width": 120, "height": 20 }
          }
        },
        "verification": {
          "verificationPurpose": {
            "pdfFieldName": "verification_purpose",
            "type": "textarea",
            "required": true,
            "label": "Purpose of Verification",
            "coordinates": { "x": 150, "y": 260, "width": 400, "height": 60 }
          },
          "requestedBy": {
            "pdfFieldName": "requested_by",
            "type": "text",
            "required": true,
            "label": "Requested By (Organization)",
            "coordinates": { "x": 150, "y": 340, "width": 200, "height": 20 }
          },
          "contactInfo": {
            "pdfFieldName": "contact_info",
            "type": "text",
            "required": false,
            "label": "Contact Information",
            "coordinates": { "x": 370, "y": 340, "width": 180, "height": 20 }
          },
          "verificationDate": {
            "pdfFieldName": "verification_date",
            "type": "date",
            "required": true,
            "label": "Verification Date",
            "coordinates": { "x": 150, "y": 380, "width": 120, "height": 20 }
          },
          "hrSignature": {
            "pdfFieldName": "hr_signature",
            "type": "signature",
            "required": true,
            "label": "HR Representative Signature",
            "coordinates": { "x": 150, "y": 420, "width": 200, "height": 50 }
          },
          "hrName": {
            "pdfFieldName": "hr_name",
            "type": "text",
            "required": true,
            "label": "HR Representative Name",
            "coordinates": { "x": 370, "y": 420, "width": 180, "height": 20 }
          },
          "hrTitle": {
            "pdfFieldName": "hr_title",
            "type": "text",
            "required": true,
            "label": "HR Title",
            "coordinates": { "x": 370, "y": 450, "width": 180, "height": 20 }
          }
        }
