# =============================================================================
# PDF Auto-Populate Enhanced - FREE TIER CONFIGURATION
# =============================================================================

# Application Settings
NODE_ENV=development
APP_NAME="PDF Auto-Populate Enhanced"
PORT=3000
HOST=localhost
BASE_URL=http://localhost:3000

# Database (Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/pdf-auto-populate

# Security (GENERATE THESE SECRETS)
JWT_SECRET=4f5c58d2e36f4d9666571221d353b380734ed8f29676164d083f215f53060e9979b04c0d3b86a275a9044514b3ab690f1a86b64e943066e89614cecf54930ca6
SESSION_SECRET=d765502d7b6b1c46b21a643fff72263520b3b10e5869cb5bfc9cc957211af589
BCRYPT_SALT_ROUNDS=12

# File Storage
UPLOAD_PATH=./public/uploads
UPLOAD_PDF_PATH=./public/uploads/pdfs
UPLOAD_SIGNATURE_PATH=./public/uploads/signatures
UPLOAD_TEMPLATE_PATH=./public/uploads/templates
UPLOAD_EXPORT_PATH=./public/uploads/exports

MAX_FILE_SIZE_PDF=26214400
MAX_FILE_SIZE_SIGNATURE=2097152

# PDF Processing
PDF_ENGINE=pdf-lib
PDF_FIELD_DETECTION_ENABLED=true
PDF_SIGNATURE_DETECTION_ENABLED=true

# Email (Optional - Comment out if not needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-actual-gmail@gmail.com
# SMTP_PASS=your-actual-app-password

# Caching
CACHE_ENABLED=true
CACHE_TTL=3600

# Logging
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log

# Security
CORS_ORIGIN=http://localhost:3000
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_WINDOW=15
SECURITY_RATE_LIMIT_MAX=100

# Features
FEATURE_USER_REGISTRATION=true
FEATURE_DRAG_DROP_FIELDS=true
FEATURE_PROPERTY_PANEL=true