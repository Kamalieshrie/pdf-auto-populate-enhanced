<svg width="200" height="60" viewBox="0 0 200 60" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Gradient for modern look -->
    <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1E40AF;stop-opacity:1" />
    </linearGradient>
    
    <!-- Shadow filter -->
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="2" dy="2" stdDeviation="3" flood-color="#000000" flood-opacity="0.1"/>
    </filter>
  </defs>
  
  <!-- Background circle for icon -->
  <circle cx="30" cy="30" r="25" fill="url(#logoGradient)" filter="url(#shadow)"/>
  
  <!-- PDF Document Icon -->
  <g transform="translate(18, 18)">
    <!-- Document body -->
    <path d="M4 2 h14 l4 4 v16 a2 2 0 0 1-2 2 H4 a2 2 0 0 1-2-2 V4 a2 2 0 0 1 2-2 Z" 
          fill="white" stroke="none"/>
    
    <!-- Document corner fold -->
    <path d="M18 2 v4 h4" fill="none" stroke="#E5E7EB" stroke-width="1.5" stroke-linecap="round"/>
    
    <!-- PDF text -->
    <text x="12" y="16" text-anchor="middle" fill="#3B82F6" font-family="Arial, sans-serif" font-size="6" font-weight="bold">PDF</text>
    
    <!-- Auto-fill lines representing form fields -->
    <rect x="6" y="10" width="8" height="1" fill="#E5E7EB" rx="0.5"/>
    <rect x="6" y="18" width="6" height="1" fill="#E5E7EB" rx="0.5"/>
    <rect x="6" y="20" width="10" height="1" fill="#E5E7EB" rx="0.5"/>
    
    <!-- Magic wand for auto-populate -->
    <g transform="translate(16, 8)">
      <line x1="0" y1="6" x2="4" y2="2" stroke="#F59E0B" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="0" cy="6" r="1" fill="#F59E0B"/>
      <!-- Sparkles -->
      <circle cx="2" cy="0" r="0.5" fill="#FCD34D"/>
      <circle cx="5" cy="3" r="0.5" fill="#FCD34D"/>
      <circle cx="1" cy="4" r="0.5" fill="#FCD34D"/>
    </g>
  </g>
  
  <!-- Company/App Name -->
  <text x="70" y="25" fill="#1F2937" font-family="Arial, sans-serif" font-size="16" font-weight="bold">AutoFill</text>
  <text x="70" y="42" fill="#6B7280" font-family="Arial, sans-serif" font-size="12" font-weight="normal">PDF Pro</text>
  
  <!-- Tagline -->
  <text x="70" y="52" fill="#9CA3AF" font-family="Arial, sans-serif" font-size="8">Smart Document Population</text>
</svg>